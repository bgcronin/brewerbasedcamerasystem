{
  "name": "lumen-slit-lamp-imaging",
  "private": true,
  "version": "1.0.0",
  "description": "Browser-based slit lamp photography for the ophthalmology clinic",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node --check dist/sw.js",
    "preview": "vite preview",
    "start": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ocr-assets": "node scripts/copy-ocr-assets.mjs",
    "prebuild": "node scripts/copy-ocr-assets.mjs",
    "predev": "node scripts/copy-ocr-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "idb": "^8.0.4",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@vitejs/plugin-react": "^6.2.1",
    "fake-indexeddb": "^6.2.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
