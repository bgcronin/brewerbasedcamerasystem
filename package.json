{
  "name": "lumen-slit-lamp-imaging",
  "private": true,
  "version": "1.0.0",
  "description": "Browser-based slit lamp photography for the ophthalmology clinic",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
